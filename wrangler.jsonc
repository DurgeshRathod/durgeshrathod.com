{
  // Static-assets-only Worker.
  //
  // There is deliberately NO "main" field. Without one, Cloudflare deploys the contents of
  // ./dist as static files and runs no Worker script — which is exactly what this site is.
  //
  // This file exists to stop Cloudflare's framework detection from adding @astrojs/cloudflare
  // during the build. That adapter targets the Workers runtime, which cannot load the native
  // binary resvg uses to render OG images, so the build fails with UNLOADABLE_DEPENDENCY.
  // resvg only ever runs on the build machine; declaring the deployment explicitly keeps it
  // that way.
  //
  // If you ever genuinely need server-side rendering, that is the point to add the adapter —
  // and to move OG generation off the request path first.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "durgeshrathod-com",
  "compatibility_date": "2026-08-02",
  // Removes the durgeshrathod-com.durgeshrathod-777.workers.dev route.
  //
  // That hostname served a complete, crawlable third copy of the site. Every page there
  // canonicalises to durgeshrathod.com, so it was not competing for rankings — but Google
  // still had to fetch all 40 URLs to learn that, and a new domain's crawl budget is small
  // enough that spending it on duplicates measurably delays indexing of the real pages.
  // The apex domain is the only route this site should answer on.
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    // Astro emits /404.html; serve it for unmatched paths rather than a bare Cloudflare error.
    "not_found_handling": "404-page",
    // Astro builds /solutions/index.html, and Cloudflare's default ("auto-trailing-slash")
    // therefore 307-redirects /solutions → /solutions/. But Seo.astro emits canonical URLs
    // WITHOUT a trailing slash, so the served URL would contradict the canonical tag and
    // every internal link would cost a redirect hop.
    //
    // "drop-trailing-slash" serves /solutions directly from /solutions/index.html and
    // redirects the slashed form instead — so the served URL, the canonical tag, the sitemap
    // and every internal href all agree on one spelling.
    "html_handling": "drop-trailing-slash"
  },
  "observability": {
    "enabled": true
  }
}
