---
import Base from '../../layouts/Base.astro';
import CtaRow from '../../components/CtaRow.astro';
import solutions from '../../data/solutions.json';
import { PILLARS, OFFERS } from '../../consts.ts';
import { href } from '../../lib/paths.ts';
import { breadcrumbSchema, canonical } from '../../lib/seo.ts';

const list = [...solutions.solutions].sort((a, b) => a.order - b.order);
const pillarName = (id: string) => PILLARS.find((p) => p.id === id)?.name ?? id;

const schema = [
  {
    '@type': 'CollectionPage',
    name: 'Solutions — AI agent reliability engagements',
    description: solutions.meta.description,
    hasPart: list.map((s) => ({
      '@type': 'Service',
      name: s.name,
      description: s.description,
      url: canonical(`/solutions/${s.slug}`),
    })),
  },
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Solutions', path: '/solutions' },
  ]),
];
---

<Base
  title="Solutions — what I get hired to do"
  description="Five AI agent reliability engagements with the full method, effort estimates and the artefact you keep: eval suites, observability and tracing, cost reduction, multi-tenant isolation, and text-to-SQL reliability."
  path="/solutions"
  schema={schema}
>
  <section class="container-page pt-14 pb-10">
    <nav aria-label="Breadcrumb" class="text-sm" style="color: var(--fg-subtle);">
      <a href={href('/')} class="hover:underline">Home</a>
      <span class="mx-1.5" aria-hidden="true">/</span>
      <span style="color: var(--fg-muted);">Solutions</span>
    </nav>

    <h1 class="text-h1 mt-8 max-w-3xl font-semibold" style="text-wrap: balance;">
      Five things I get hired to do
    </h1>
    <p class="text-lead mt-5 max-w-2xl" style="color: var(--fg-muted);">
      {solutions.meta.premise}
    </p>
  </section>

  <section class="container-page pb-16">
    <div class="grid gap-5">
      {
        list.map((s, i) => (
          <a
            href={href(`/solutions/${s.slug}`)}
            class="group grid gap-6 rounded-2xl border p-7 transition-transform hover:-translate-y-0.5 lg:grid-cols-[1.35fr_1fr] lg:gap-10"
            style="background: var(--bg-raised); box-shadow: var(--shadow-card);"
            data-reveal
            data-reveal-delay={i * 60}
          >
            <div>
              <p class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-wider">
                <span style="color: var(--accent);">{pillarName(s.pillar)}</span>
                <span style="color: var(--fg-subtle);">· {s.method.length} phases</span>
              </p>
              <h2 class="text-h3 mt-2.5 font-semibold leading-snug">{s.name}</h2>
              <p class="mt-2 text-[15px] font-medium leading-snug">{s.tagline}</p>
              <p class="mt-3 text-[15px] leading-relaxed" style="color: var(--fg-muted);">
                {s.outcome}
              </p>
              <span
                class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold"
                style="color: var(--accent);"
              >
                The method, and what it costs
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  class="size-3.5 transition-transform group-hover:translate-x-0.5"
                  aria-hidden="true"
                >
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </span>
            </div>

            <div>
              <p class="text-xs font-semibold uppercase tracking-wider" style="color: var(--fg-subtle);">
                You have this if
              </p>
              <ul class="mt-2.5 grid gap-1.5 text-[13px]">
                {s.symptoms.slice(0, 3).map((sym) => (
                  <li class="flex gap-2" style="color: var(--fg-muted);">
                    <span style="color: var(--risk);" aria-hidden="true">
                      ·
                    </span>
                    <span>{sym}</span>
                  </li>
                ))}
              </ul>
              <p class="mt-3 flex flex-wrap gap-1.5">
                {s.domains.map((d) => (
                  <span class="rounded-md border px-2 py-0.5 text-[11px]" style="color: var(--fg-subtle);">
                    {d}
                  </span>
                ))}
              </p>
            </div>
          </a>
        ))
      }
    </div>

    <div class="mt-12 grid gap-5 lg:grid-cols-2">
      <div class="rounded-2xl border p-7" style="background: var(--bg-raised);">
        <h2 class="text-h3 font-semibold">Not sure which applies?</h2>
        <p class="mt-2.5 text-[15px] leading-relaxed" style="color: var(--fg-muted);">
          The free scorecard scores your agent across all three pillars in four minutes and
          ranks your gaps — which effectively picks the page you should be reading.
        </p>
        <a
          href={href('/scorecard')}
          data-analytics="solutions-scorecard"
          class="mt-6 inline-flex items-center gap-2 rounded-xl px-5 py-3 text-[15px] font-semibold transition-opacity hover:opacity-90"
          style="background: var(--accent-solid); color: var(--accent-solid-fg);"
        >
          Run the scorecard
        </a>
      </div>

      <div class="rounded-2xl border p-7" style="background: var(--bg-raised);">
        <h2 class="text-h3 font-semibold">How these map to engagements</h2>
        <p class="mt-2.5 text-[15px] leading-relaxed" style="color: var(--fg-muted);">
          Most of these are scoped inside the {OFFERS[0].name} ({OFFERS[0].priceLabel}). Several
          together, or ongoing ownership of them, is the {OFFERS[1].name} ({OFFERS[1].priceLabel}).
        </p>
        <div class="mt-6">
          <CtaRow source="solutions-hub" intent="audit" primaryLabel="Talk about scope" booking={false} email={false} />
        </div>
      </div>
    </div>
  </section>
</Base>
