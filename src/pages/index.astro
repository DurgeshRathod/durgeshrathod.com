---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import CtaRow from '../components/CtaRow.astro';
import Faq from '../components/Faq.astro';
import Availability from '../components/Availability.astro';
import { SITE, PILLARS, PROOF, OFFERS } from '../consts.ts';
import { href } from '../lib/paths.ts';
import { faqSchema, softwareSourceSchema, type QA } from '../lib/seo.ts';
import scorecard from '../data/scorecard.json';
import taxonomy from '../data/taxonomy.json';
import { getCollection } from 'astro:content';

const cases = (await getCollection('work'))
  .filter((c) => !c.data.draft)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

/*
  FAQ answers are written to be extractable: a direct answer in the first sentence,
  then the reasoning. This is the format both search snippets and AI answer engines
  quote, and it is also just clearer for a human skimming.
*/
const faqs: QA[] = [
  {
    q: 'What does "making an AI agent production-ready" actually involve?',
    a: 'Three things, in this order: an eval suite so you can tell whether a change made the agent better or worse, tracing so a failure can be reproduced and diagnosed, and cost controls so spend and latency are bounded rather than discovered on an invoice.\n\nMost teams have none of the three when they first ship. The model is rarely the problem — the missing engineering discipline around it is.',
  },
  {
    q: 'How much does it cost to work with you?',
    a: `Two options, both fixed-price. The ${OFFERS[0].name} is ${OFFERS[0].priceLabel} for ${OFFERS[0].duration} and produces a failure taxonomy, a cost and latency profile, an eval suite you keep, and a prioritised fix list. The ${OFFERS[1].name} is ${OFFERS[1].priceLabel} at roughly two days a week.\n\nI quote fixed scope rather than hourly rates, so the price is the price regardless of how long something takes me.`,
  },
  {
    q: 'You are in India — does the timezone work for a US or European team?',
    a: 'Yes, with real overlap rather than the pretence of it. I hold 09:00–21:00 IST open, which covers the full European working day and US mornings on the earlier side. That is typically four or more shared hours with London and two to three with New York.\n\nBeyond that I work async-first: written updates, recorded walkthroughs, and traceable work rather than requiring meetings.',
  },
  {
    q: 'Do you work with agents built on frameworks you have not used?',
    a: 'Yes. The failure modes are framework-independent — unvalidated tool arguments, unbounded loops, missing evals, no tracing, and cost with no ceiling look the same in LangGraph, CrewAI, the raw provider SDKs, or hand-rolled orchestration.\n\nI have shipped production systems on CrewAI, LangChain, Model Context Protocol, AWS Bedrock, and direct provider APIs. Framework specifics are a day of reading; the reliability work is the same job.',
  },
  {
    q: 'What do you need from us to start an audit?',
    a: 'Read access to the agent code, whatever logs or traces already exist, and 60–90 minutes with an engineer who knows the system. Ideally a sample of real production inputs, anonymised if necessary.\n\nIf you have no traces at all, that is not a blocker — it is usually the first finding.',
  },
  {
    q: 'Can I just use the free scorecard and fix things myself?',
    a: `Yes, and that is a genuinely good outcome. The ${scorecard.questions.length}-question scorecard names the gaps, ranks them by production risk, and gives each one a fix with an effort estimate. Plenty of teams need the map rather than a consultant.\n\nHire me when the gaps are clear but nobody has the time or the specific experience to close them.`,
  },
];

const schema = [
  faqSchema(faqs),
  ...softwareSourceSchema(),
];
---

<Base
  title={SITE.tagline}
  description={SITE.description}
  path="/"
  titleSuffix={` — ${SITE.name}`}
  schema={schema}
>
  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="relative overflow-hidden">
    <!-- Faint grid, purely decorative: reads as instrumentation rather than marketing gradient. -->
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.14]"
      aria-hidden="true"
      style="background-image: linear-gradient(var(--border-strong) 1px, transparent 1px), linear-gradient(90deg, var(--border-strong) 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(ellipse 80% 55% at 50% 0%, black 40%, transparent 100%);"
    >
    </div>

    <div class="container-page relative pt-16 pb-14 sm:pt-24 sm:pb-20">
      <div class="grid gap-12 lg:grid-cols-[1.55fr_1fr] lg:gap-16">
        <div>
          <p
            class="inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs font-semibold"
            style="color: var(--fg-muted);"
            data-reveal
          >
            <span class="size-1.5 rounded-full" style="background: var(--good);"></span>
            Independent · taking audits and one more retainer
          </p>

          <h1 class="text-display mt-6 font-semibold" style="text-wrap: balance;" data-reveal data-reveal-delay="60">
            I make AI agents<br />
            <span style="color: var(--accent);">survive production.</span>
          </h1>

          <p class="text-lead mt-6 max-w-xl" style="color: var(--fg-muted);" data-reveal data-reveal-delay="120">
            Your agent works in the demo. Then real users arrive, costs triple, and nobody can
            explain why it failed at 2am. I close that gap — evals, observability, and cost
            control — with nine years of distributed systems behind it.
          </p>

          <div class="mt-9" data-reveal data-reveal-delay="180">
            <CtaRow source="hero" intent="audit" primaryLabel="Talk about an audit" />
          </div>

          <p class="mt-5 text-sm" style="color: var(--fg-subtle);" data-reveal data-reveal-delay="220">
            Not ready to talk? <a
              href={href('/scorecard')}
              class="font-medium underline decoration-1 underline-offset-4"
              style="color: var(--fg);">Score your agent in {scorecard.meta.estimatedMinutes} minutes</a
            > — free, no signup, nothing leaves your browser.
          </p>
        </div>

        <div class="lg:pt-2" data-reveal data-reveal-delay="240">
          <Availability avatar />
        </div>
      </div>
    </div>
  </section>

  <!-- ── Proof numbers ────────────────────────────────────────────────── -->
  <section class="border-y" style="background: var(--bg-raised);">
    <div class="container-page py-10">
      <h2 class="sr-only">Track record</h2>
      <dl class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          PROOF.map((p, i) => (
            <div data-reveal data-reveal-delay={i * 60}>
              <dt class="text-xs font-semibold uppercase tracking-wider" style="color: var(--fg-subtle);">
                {p.label}
              </dt>
              <dd class="mt-2">
                <a href={href(p.href)} class="group block">
                  <span class="flex items-baseline gap-1 font-semibold tracking-tight">
                    <span class="text-h2 tabular-nums" data-countup={p.value}>
                      {p.value.toLocaleString('en-US')}
                    </span>
                    <span class="text-h3" style="color: var(--accent);">{p.unit}</span>
                  </span>
                  <span class="mt-0.5 block text-sm" style="color: var(--fg-muted);">
                    {p.suffix}
                  </span>
                  <span
                    class="mt-2 block text-[13px] leading-relaxed opacity-0 transition-opacity group-hover:opacity-100"
                    style="color: var(--fg-subtle);"
                  >
                    {p.detail}
                  </span>
                </a>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ── The problem: three pillars ───────────────────────────────────── -->
  <Section
    eyebrow="The three ways agents die"
    heading="A prototype has to work once. A product has to work on inputs nobody imagined."
    lede="Almost every failing agent system I have looked at is failing in one of three places. They are unglamorous and they are all fixable in days, not quarters."
  >
    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {
        PILLARS.map((p, i) => (
          <article
            class="flex flex-col rounded-2xl border p-6 transition-transform hover:-translate-y-0.5"
            style="background: var(--bg-raised); box-shadow: var(--shadow-card);"
            data-reveal
            data-reveal-delay={i * 80}
          >
            <span
              class="font-mono text-xs font-bold tracking-wider"
              style="color: var(--accent);"
            >
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="text-h3 mt-3 font-semibold">{p.name}</h3>
            <p class="mt-2 text-[15px] font-medium leading-snug">{p.claim}</p>
            <p class="mt-3 text-sm leading-relaxed" style="color: var(--fg-muted);">
              {p.body}
            </p>
          </article>
        ))
      }
    </div>

    <div class="mt-6 rounded-2xl border p-6" data-reveal>
      <p class="text-[15px] leading-relaxed" style="color: var(--fg-muted);">
        <strong style="color: var(--fg);">The uncomfortable version:</strong> none of this is
        about model choice, and very little of it is about prompts. It is the boring
        engineering that conventional services got right twenty years ago and agent
        codebases skipped — validation at boundaries, bounded resources, traceable failures.
        I have <a
          href={href('/tools/failure-taxonomy')}
          class="font-medium underline decoration-1 underline-offset-4"
          style="color: var(--fg);">catalogued {taxonomy.symptoms.length} of these failure modes</a
        > with the causes and fixes for each.
      </p>
    </div>
  </Section>

  <!-- ── Scorecard: the lead magnet ───────────────────────────────────── -->
  <section class="py-4">
    <div class="container-page">
      <div
        class="relative overflow-hidden rounded-3xl border p-8 sm:p-12"
        style="background: var(--bg-raised); box-shadow: var(--shadow-card);"
        data-reveal
      >
        <div
          class="pointer-events-none absolute -right-24 -top-24 size-72 rounded-full opacity-[0.12]"
          aria-hidden="true"
          style="background: radial-gradient(circle, var(--accent), transparent 70%);"
        >
        </div>

        <div class="relative grid gap-8 lg:grid-cols-[1.5fr_1fr] lg:items-center">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.14em]" style="color: var(--accent);">
              Free · {scorecard.meta.estimatedMinutes} minutes · no signup
            </p>
            <h2 class="text-h2 mt-3 font-semibold" style="text-wrap: balance;">
              Is your agent production-ready, or just working today?
            </h2>
            <p class="mt-4 max-w-xl text-[15px] leading-relaxed" style="color: var(--fg-muted);">
              {scorecard.questions.length} questions on the things that actually cause incidents.
              You get a score out of 100, a breakdown across the three pillars, and your gaps
              ranked by risk — each with a specific fix and an effort estimate. It runs entirely
              in your browser; no answers are transmitted anywhere.
            </p>
            <div class="mt-7 flex flex-wrap items-center gap-3">
              <a
                href={href('/scorecard')}
                data-analytics="home-scorecard"
                class="inline-flex items-center gap-2 rounded-xl px-5 py-3 text-[15px] font-semibold transition-all hover:opacity-90 active:scale-[0.98]"
                style="background: var(--accent-solid); color: var(--accent-solid-fg);"
              >
                Score my agent
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="size-4" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </a>
              <span class="text-sm" style="color: var(--fg-subtle);">
                Most teams score in the 30s the first time.
              </span>
            </div>
          </div>

          <ul class="grid gap-2.5 text-sm">
            {
              scorecard.pillars.map((p) => (
                <li class="rounded-xl border p-4" style="background: var(--bg);">
                  <span class="font-semibold">{p.name}</span>
                  <span class="mt-1 block" style="color: var(--fg-muted);">
                    {p.blurb}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Case studies ─────────────────────────────────────────────────── -->
  {
    cases.length > 0 && (
      <Section
        eyebrow="Evidence"
        heading="Systems I have taken to production"
        lede="Each of these includes the architecture, the number it is remembered for, and the thing that broke on the way. The failure is the part that makes the rest believable."
      >
        <div class="mt-12 grid gap-5 md:grid-cols-3">
          {cases.map((c, i) => (
            <a
              href={href(`/work/${c.id}`)}
              class="group flex flex-col rounded-2xl border p-6 transition-transform hover:-translate-y-0.5"
              style="background: var(--bg-raised); box-shadow: var(--shadow-card);"
              data-reveal
              data-reveal-delay={i * 80}
            >
              <div class="flex items-baseline gap-2">
                <span class="text-h2 font-semibold tabular-nums tracking-tight" style="color: var(--accent);">
                  {c.data.headlineStat.value}
                </span>
              </div>
              <p class="mt-1 text-xs font-semibold uppercase tracking-wider" style="color: var(--fg-subtle);">
                {c.data.headlineStat.label}
              </p>
              <h3 class="text-h3 mt-4 font-semibold leading-snug">
                {c.data.cardTitle ?? c.data.title}
              </h3>
              <p class="mt-2.5 flex-1 text-sm leading-relaxed" style="color: var(--fg-muted);">
                {c.data.description}
              </p>
              <span
                class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold"
                style="color: var(--accent);"
              >
                Read it
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  class="size-3.5 transition-transform group-hover:translate-x-0.5"
                  aria-hidden="true"
                >
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </span>
            </a>
          ))}
        </div>
      </Section>
    )
  }

  <!-- ── Offers ───────────────────────────────────────────────────────── -->
  <Section
    eyebrow="How to work with me"
    heading="Two ways in, both fixed-price"
    lede="Prices are on the page because hiding them wastes everyone's time. Fixed scope rather than hourly, so the number does not move."
    bordered
  >
    <div class="mt-12 grid gap-5 lg:grid-cols-2">
      {
        OFFERS.map((o, i) => (
          <article
            id={o.id}
            class="flex flex-col rounded-2xl border p-7"
            style={`background: var(--bg-raised); box-shadow: var(--shadow-card); ${i === 0 ? 'border-color: var(--accent);' : ''}`}
            data-reveal
            data-reveal-delay={i * 80}
          >
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-xs font-semibold uppercase tracking-wider" style="color: var(--fg-subtle);">
                  {o.kind} · {o.duration}
                </p>
                <h3 class="text-h3 mt-2 font-semibold">{o.name}</h3>
              </div>
              {i === 0 && (
                <span
                  class="shrink-0 rounded-full px-2.5 py-1 text-[11px] font-bold uppercase tracking-wide"
                  style="background: var(--accent-soft); color: var(--accent);"
                >
                  Start here
                </span>
              )}
            </div>

            <p class="text-h3 mt-4 font-semibold tabular-nums">{o.priceLabel}</p>
            <p class="mt-3 text-[15px] leading-relaxed" style="color: var(--fg-muted);">
              {o.summary}
            </p>

            <ul class="mt-5 grid flex-1 gap-2.5 text-sm">
              {o.deliverables.map((d) => (
                <li class="flex gap-2.5">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                    class="mt-1 size-3.5 shrink-0"
                    style="color: var(--good);"
                    aria-hidden="true"
                  >
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                  <span style="color: var(--fg-muted);">{d}</span>
                </li>
              ))}
            </ul>

            <p class="mt-5 rounded-lg border-l-2 pl-3 text-sm italic" style="border-color: var(--accent); color: var(--fg-muted);">
              {o.bestFor}
            </p>
          </article>
        ))
      }
    </div>

    <div class="mt-8" data-reveal>
      <a
        href={href('/work-with-me')}
        class="inline-flex items-center gap-2 text-[15px] font-semibold"
        style="color: var(--accent);"
      >
        Full scope, process, and what I will not do
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="size-4" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
    </div>
  </Section>

  <!-- ── FAQ ──────────────────────────────────────────────────────────── -->
  <Section eyebrow="Questions" heading="The things people ask first" bordered>
    <div class="mt-10 max-w-3xl">
      <Faq items={faqs} />
    </div>
  </Section>

  <!-- ── Closing CTA ──────────────────────────────────────────────────── -->
  <section class="pb-8">
    <div class="container-page">
      <div
        class="rounded-3xl border p-8 text-center sm:p-14"
        style="background: var(--bg-raised); box-shadow: var(--shadow-card);"
        data-reveal
      >
        <h2 class="text-h2 font-semibold" style="text-wrap: balance;">
          Tell me what your agent does and what worries you.
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-[15px] leading-relaxed" style="color: var(--fg-muted);">
          A message describing your stack and volume is enough for me to say something useful
          back — usually the same day, and usually including at least one thing you can fix
          without hiring anyone.
        </p>
        <div class="mt-8 flex justify-center">
          <CtaRow source="footer-cta" intent="audit" align="center" primaryLabel="Start a conversation" />
        </div>
      </div>
    </div>
  </section>
</Base>
