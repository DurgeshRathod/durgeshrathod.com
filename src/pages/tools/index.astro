---
import Base from '../../layouts/Base.astro';
import CtaRow from '../../components/CtaRow.astro';
import scorecard from '../../data/scorecard.json';
import taxonomy from '../../data/taxonomy.json';
import models from '../../data/models.json';
import { href } from '../../lib/paths.ts';
import { breadcrumbSchema } from '../../lib/seo.ts';

const tools = [
  {
    name: scorecard.meta.title,
    path: '/scorecard',
    kind: 'Assessment',
    time: `${scorecard.meta.estimatedMinutes} minutes`,
    summary: scorecard.meta.description,
    facts: [
      `${scorecard.questions.length} weighted questions`,
      'Scored 0–100 across three pillars',
      'Gaps ranked by production risk',
      'Runs entirely in your browser',
    ],
  },
  {
    name: 'Agent Cost Calculator',
    path: '/tools/agent-cost-calculator',
    kind: 'Calculator',
    time: '2 minutes',
    summary:
      'Model monthly LLM spend from volume, tokens, retries and cache hits — including the tool-definition tokens and tokenizer differences most calculators ignore.',
    facts: [
      `Provider pricing verified ${models.meta.updated}`,
      `${models.models.length} models compared side by side`,
      `${models.presets.length} realistic workload presets`,
      'Ranked savings scenarios with effort estimates',
    ],
  },
  {
    name: taxonomy.meta.title,
    path: '/tools/ai-agent-failure-modes',
    kind: 'Reference',
    time: 'Browse',
    summary: taxonomy.meta.description,
    facts: [
      `${taxonomy.symptoms.length} named failure modes`,
      'Root causes with a diagnostic check for each',
      'Fixes with effort estimates',
      'Filterable by pillar and severity',
    ],
  },
];

const schema = [
  {
    '@type': 'CollectionPage',
    name: 'Free tools for teams running AI agents in production',
    description:
      'A readiness assessment, a cost calculator, and a failure taxonomy — free, no signup, running entirely client-side.',
  },
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Tools', path: '/tools' },
  ]),
];
---

<Base
  title="Free tools for teams running AI agents in production"
  description="Three free tools: a 12-question agent production readiness scorecard, an LLM cost calculator with pricing verified August 2026, and a taxonomy of nine named agent failure modes with causes and fixes."
  path="/tools"
  schema={schema}
>
  <section class="container-page pt-14 pb-10">
    <nav aria-label="Breadcrumb" class="text-sm" style="color: var(--fg-subtle);">
      <a href={href('/')} class="hover:underline">Home</a>
      <span class="mx-1.5" aria-hidden="true">/</span>
      <span style="color: var(--fg-muted);">Tools</span>
    </nav>

    <h1 class="text-h1 mt-8 max-w-3xl font-semibold" style="text-wrap: balance;">
      Tools for teams running agents in production
    </h1>
    <p class="text-lead mt-5 max-w-2xl" style="color: var(--fg-muted);">
      All free, no signup, and no data leaves your browser — they are static pages with
      JavaScript, so there is nowhere for it to go. Built because I needed them for client work
      and it was easier to make them public than to keep rebuilding them.
    </p>
  </section>

  <section class="container-page pb-16">
    <div class="grid gap-5">
      {
        tools.map((t, i) => (
          <a
            href={href(t.path)}
            class="group grid gap-6 rounded-2xl border p-7 transition-transform hover:-translate-y-0.5 lg:grid-cols-[1.4fr_1fr] lg:gap-10"
            style="background: var(--bg-raised); box-shadow: var(--shadow-card);"
            data-reveal
            data-reveal-delay={i * 70}
          >
            <div>
              <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider">
                <span style="color: var(--accent);">{t.kind}</span>
                <span style="color: var(--fg-subtle);">· {t.time}</span>
              </p>
              <h2 class="text-h3 mt-2.5 font-semibold leading-snug">{t.name}</h2>
              <p class="mt-3 text-[15px] leading-relaxed" style="color: var(--fg-muted);">
                {t.summary}
              </p>
              <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold" style="color: var(--accent);">
                Open it
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="size-3.5 transition-transform group-hover:translate-x-0.5" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </span>
            </div>

            <ul class="grid content-start gap-2 text-sm">
              {t.facts.map((f) => (
                <li class="flex gap-2.5">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="mt-1 size-3 shrink-0" style="color: var(--good);" aria-hidden="true">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                  <span style="color: var(--fg-muted);">{f}</span>
                </li>
              ))}
            </ul>
          </a>
        ))
      }
    </div>

    <div class="mt-12 rounded-2xl border p-7" style="background: var(--bg-raised);">
      <h2 class="text-h3 font-semibold">Something missing?</h2>
      <p class="mt-2.5 max-w-2xl text-[15px] leading-relaxed" style="color: var(--fg-muted);">
        If there is a calculation or reference you keep rebuilding by hand, tell me — I will
        probably build it, because I likely need it too.
      </p>
      <div class="mt-6">
        <CtaRow source="tools-index" intent="general" primaryLabel="Suggest a tool" booking={false} email={false} />
      </div>
    </div>
  </section>
</Base>
