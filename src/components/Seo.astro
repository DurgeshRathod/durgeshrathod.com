---
import { SITE } from '../consts.ts';
import { canonical, graph } from '../lib/seo.ts';

interface Props {
  title: string;
  description: string;
  /** Route path, e.g. '/work-with-me'. Drives canonical + OG url. */
  path: string;
  /** Extra JSON-LD nodes merged into the site-wide @graph. */
  schema?: object[];
  /** Absolute or root-relative OG image. Defaults to the generated per-page image. */
  image?: string;
  noindex?: boolean;
  /** ISO dates for article-type pages. */
  published?: string;
  updated?: string;
  /** Overrides the <title> suffix; pass '' for the homepage. */
  titleSuffix?: string;
}

const {
  title,
  description,
  path,
  schema = [],
  image,
  noindex = false,
  published,
  updated,
  titleSuffix = ` — ${SITE.shortName}`,
} = Astro.props;

const url = canonical(path);
const fullTitle = `${title}${titleSuffix}`;

// OG images are generated at build time into /og/<slug>.png by src/pages/og/[...slug].png.ts
const ogSlug = (path.replace(/^\//, '') || 'index').replace(/\//g, '-');
const ogImage = new URL(image ?? `/og/${ogSlug}.png`, SITE.url).href;

const jsonLd = graph(...schema);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />

{
  noindex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
  )
}

<meta name="author" content={SITE.name} />
<meta name="generator" content={Astro.generator} />

<!-- Open Graph -->
<meta property="og:type" content={published ? 'article' : 'website'} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:locale" content="en_US" />
{published && <meta property="article:published_time" content={published} />}
{(updated ?? published) && <meta property="article:modified_time" content={updated ?? published} />}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!--
  Structured data. One @graph per page so the Person / WebSite / Service entities
  are cross-referenced by @id rather than repeated as disconnected blobs.
-->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
