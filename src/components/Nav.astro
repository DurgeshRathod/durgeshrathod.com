---
import { NAV, SITE } from '../consts.ts';
import { href, isActive } from '../lib/paths.ts';
import { waLink, WA_MESSAGES } from '../lib/whatsapp.ts';

const current = Astro.url.pathname;
---

<header
  class="sticky top-0 z-40 border-b backdrop-blur-xl"
  style="background: color-mix(in oklab, var(--bg) 82%, transparent);"
>
  <div class="container-page flex h-16 items-center gap-4">
    <a
      href={href('/')}
      class="group flex shrink-0 items-center gap-2.5 font-semibold tracking-tight"
      aria-label={`${SITE.name} — home`}
    >
      <span
        class="grid size-8 place-items-center rounded-lg font-mono text-[13px] font-bold transition-transform group-hover:scale-105"
        style="background: var(--accent-solid); color: var(--accent-solid-fg);"
        aria-hidden="true">DR</span
      >
      <span class="hidden text-[15px] sm:inline">{SITE.name}</span>
    </a>

    <nav class="ml-auto hidden items-center gap-1 lg:flex" aria-label="Main">
      {
        NAV.map((item) => {
          const active = isActive(current, item.href);
          return (
            <a
              href={href(item.href)}
              aria-current={active ? 'page' : undefined}
              class="rounded-lg px-3 py-2 text-sm font-medium transition-colors"
              style={
                active
                  ? 'color: var(--fg); background: var(--bg-sunken);'
                  : 'color: var(--fg-muted);'
              }
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="ml-auto flex items-center gap-1.5 lg:ml-0">
      <button
        type="button"
        data-cmdk-open
        class="hidden items-center gap-2 rounded-lg border px-2.5 py-1.5 text-xs transition-colors sm:flex"
        style="color: var(--fg-subtle);"
        aria-label="Open search (Command K)"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-3.5" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
        </svg>
        <kbd class="font-mono text-[11px]">⌘K</kbd>
      </button>

      <button
        type="button"
        data-theme-toggle
        class="grid size-9 place-items-center rounded-lg border transition-colors"
        aria-label="Toggle colour theme"
      >
        <svg data-icon-sun viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-4" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg data-icon-moon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-4" aria-hidden="true">
          <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
        </svg>
      </button>

      <a
        href={waLink(WA_MESSAGES.general)}
        target="_blank"
        rel="noopener"
        data-analytics="nav-whatsapp"
        class="hidden rounded-lg px-3.5 py-2 text-sm font-semibold transition-opacity hover:opacity-90 sm:inline-block"
        style="background: var(--accent-solid); color: var(--accent-solid-fg);"
      >
        Let's talk
      </a>

      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="grid size-9 place-items-center rounded-lg border lg:hidden"
        aria-label="Open menu"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-4" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" hidden class="border-t lg:hidden" style="background: var(--bg);">
    <nav class="container-page flex flex-col py-3" aria-label="Mobile">
      {
        NAV.map((item) => (
          <a
            href={href(item.href)}
            class="rounded-lg px-3 py-2.5 text-[15px] font-medium"
            style={isActive(current, item.href) ? 'color: var(--fg);' : 'color: var(--fg-muted);'}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={href('/work-with-me')}
        class="mt-2 rounded-lg px-3 py-2.5 text-[15px] font-semibold"
        style="color: var(--accent);">Work with me →</a
      >
      <a
        href={waLink(WA_MESSAGES.general)}
        target="_blank"
        rel="noopener"
        data-analytics="nav-whatsapp-mobile"
        class="mt-2 rounded-lg px-3 py-2.5 text-center text-[15px] font-semibold"
        style="background: var(--accent-solid); color: var(--accent-solid-fg);">Message on WhatsApp</a
      >
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    // Theme toggle — writes the preference so it survives navigation.
    var root = document.documentElement;
    function paint() {
      var dark = root.dataset.theme === 'dark';
      document.querySelectorAll('[data-icon-sun]').forEach(function (el) {
        el.style.display = dark ? 'none' : '';
      });
      document.querySelectorAll('[data-icon-moon]').forEach(function (el) {
        el.style.display = dark ? '' : 'none';
      });
    }
    paint();
    document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch (e) {}
        paint();
      });
    });

    // Mobile menu
    var toggle = document.querySelector('[data-menu-toggle]');
    var menu = document.getElementById('mobile-menu');
    if (toggle && menu) {
      toggle.addEventListener('click', function () {
        var open = menu.hasAttribute('hidden');
        if (open) menu.removeAttribute('hidden');
        else menu.setAttribute('hidden', '');
        toggle.setAttribute('aria-expanded', String(open));
      });
    }
  })();
</script>
