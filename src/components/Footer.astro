---
import { SITE, CONTACT, PROFILES, NAV, NAV_SECONDARY, HAS_ANALYTICS } from '../consts.ts';
import { href } from '../lib/paths.ts';
import { waLink, WA_MESSAGES } from '../lib/whatsapp.ts';
import Availability from './Availability.astro';

const year = 2026;

const tools = [
  { label: 'Readiness Scorecard', href: '/scorecard' },
  { label: 'Agent Cost Calculator', href: '/tools/agent-cost-calculator' },
  { label: 'Failure Taxonomy', href: '/tools/ai-agent-failure-modes' },
];

const elsewhere = [
  { label: 'LinkedIn', href: PROFILES.linkedin },
  { label: 'GitHub', href: PROFILES.github },
  { label: 'fast-intent-classifier (PyPI)', href: PROFILES.pypi },
  { label: 'ai-test-gen-angular (npm)', href: PROFILES.npm },
];
---

<footer class="border-t" style="background: var(--bg-sunken);">
  <div class="container-page py-14">
    <div class="grid gap-10 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <p class="text-h3 font-semibold tracking-tight">{SITE.tagline}.</p>
        <p class="mt-3 max-w-sm text-sm leading-relaxed" style="color: var(--fg-muted);">
          Independent consulting on AI agent reliability, cost, and observability. Currently
          taking on audits and one more retainer.
        </p>

        <div class="mt-5 flex flex-wrap gap-2">
          <a
            href={waLink(WA_MESSAGES.general)}
            target="_blank"
            rel="noopener"
            data-analytics="footer-whatsapp"
            class="inline-flex items-center gap-2 rounded-lg px-3.5 py-2 text-sm font-semibold transition-opacity hover:opacity-90"
            style="background: var(--accent-solid); color: var(--accent-solid-fg);"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="size-4" aria-hidden="true">
              <path
                d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91C21.95 6.45 17.5 2 12.04 2Zm5.8 14.06c-.24.68-1.42 1.3-1.96 1.35-.54.05-1.03.24-3.5-.73-2.98-1.17-4.85-4.25-5-4.45-.14-.2-1.17-1.56-1.17-2.97 0-1.41.73-2.1 1-2.4.26-.29.58-.36.78-.36l.56.01c.18 0 .42-.07.66.5.24.58.83 2 .9 2.15.07.14.12.31.02.5-.1.2-.15.32-.29.5l-.44.5c-.14.15-.29.3-.13.6.15.29.68 1.17 1.46 1.9.99.94 1.83 1.23 2.1 1.37.26.15.42.12.58-.07.15-.2.68-.8.86-1.08.19-.29.37-.24.62-.14.24.1 1.56.73 1.83.87.27.14.44.2.51.31.07.12.07.68-.17 1.36Z"
              ></path>
            </svg>
            WhatsApp
          </a>
          <a
            href={`mailto:${CONTACT.email}`}
            data-analytics="footer-email"
            class="inline-flex items-center gap-2 rounded-lg border px-3.5 py-2 text-sm font-semibold transition-colors"
          >
            Email
          </a>
        </div>
      </div>

      <nav aria-label="Footer">
        <h2 class="text-xs font-semibold uppercase tracking-wider" style="color: var(--fg-subtle);">
          Site
        </h2>
        <ul class="mt-3 space-y-2 text-sm">
          {
            [{ label: 'Home', href: '/' }, ...NAV, ...NAV_SECONDARY, { label: 'Work with me', href: '/work-with-me' }].map(
              (i) => (
                <li>
                  <a href={href(i.href)} class="transition-colors hover:underline" style="color: var(--fg-muted);">
                    {i.label}
                  </a>
                </li>
              )
            )
          }
        </ul>
      </nav>

      <nav aria-label="Free tools">
        <h2 class="text-xs font-semibold uppercase tracking-wider" style="color: var(--fg-subtle);">
          Free tools
        </h2>
        <ul class="mt-3 space-y-2 text-sm">
          {
            tools.map((i) => (
              <li>
                <a href={href(i.href)} class="transition-colors hover:underline" style="color: var(--fg-muted);">
                  {i.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Elsewhere">
        <h2 class="text-xs font-semibold uppercase tracking-wider" style="color: var(--fg-subtle);">
          Elsewhere
        </h2>
        <ul class="mt-3 space-y-2 text-sm">
          {
            elsewhere.map((i) => (
              <li>
                <a
                  href={i.href}
                  target="_blank"
                  rel="me noopener"
                  class="transition-colors hover:underline"
                  style="color: var(--fg-muted);"
                >
                  {i.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="mt-10 max-w-md">
      <Availability compact />
    </div>

    <div
      class="mt-10 flex flex-col gap-2 border-t pt-6 text-xs sm:flex-row sm:items-center sm:justify-between"
      style="color: var(--fg-subtle);"
    >
      <p>
        © {year} {SITE.name}. Static site.{' '}
        {
          HAS_ANALYTICS
            ? 'Cookieless analytics — no cookies, no personal data, nothing shared with advertisers.'
            : 'No cookies, no analytics.'
        }
      </p>
      <p class="font-mono">
        {SITE.location} · {SITE.utcOffset}
      </p>
    </div>
  </div>
</footer>
